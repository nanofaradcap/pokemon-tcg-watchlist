# Database
# For development (SQLite)
DATABASE_URL="file:./dev.db"

# For production (PostgreSQL)
# DATABASE_URL="postgresql://username:password@localhost:5432/pokemon_tcg_watchlist"

# Scraping Configuration
SCRAPE_CONCURRENCY=2
SCRAPE_TIMEOUT_MS=12000

# TCGplayer API (optional)
ENABLE_TCGPLAYER_API=false
TCGPLAYER_PUBLIC_KEY=""
TCGPLAYER_PRIVATE_KEY=""

# Production Settings
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://cards.chencat.com"
NEXT_PUBLIC_TCGPLAYER_AFFILIATE_BASE_URL="https://partner.tcgplayer.com/c/7229328/1780961/21018"

# Puppeteer (optional override for hosted Chromium pack)
# CHROMIUM_PACK_URL="https://your-domain.com/path/to/chromium-pack.x64.tar"

# Backups
# SCHEMA_VERSION="jpNo-to-No-migration"

# API Secret (required in production)
# Shared secret checked by checkApiSecret() (src/lib/api-auth.ts) on mutating/
# sensitive routes: POST/DELETE /api/cards, POST /api/cards/refresh,
# GET /api/export, GET|POST /api/trigger-github-action, GET /api/refresh-daily-minimal.
# If unset, requests are rejected in production; unset is only tolerated as a
# local-dev convenience (NODE_ENV/VERCEL_ENV != production).
API_SECRET=""

# Client-visible copy of API_SECRET (same value), used by the browser UI
# (src/components/watchlist.tsx) to call the protected add/delete card endpoints.
# WARNING: NEXT_PUBLIC_ vars are bundled into client JS and readable by anyone —
# this is NOT real security, only a deterrent against naive/automated abuse.
# Genuine protection would require session/cookie-based auth (out of scope here).
NEXT_PUBLIC_API_SECRET=""
